# Salin menjadi .env. Generate SECRET_KEY: python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=ganti-dengan-token-acak-sebelum-menjalankan
DB_HOST=127.0.0.1
DB_PORT=3306
DB_NAME=adon_manis
DB_USER=root
DB_PASSWORD=
# Gunakan database terpisah khusus pengujian; namanya wajib diakhiri _test.
TEST_DB_NAME=adon_manis_test
